// The parts of a husk that are barely there: trailing cloth and hands of
// smoke.
//
// Drawn translucent and unlit, brightest where the surface turns away from
// the eye, and fading to nothing toward the ragged end. The vertex colour's
// alpha channel is that fade (0 at the tattered edge), painted by the art
// build as the hollow mask.
material {
  name: "Spectre",
  shading_model: unlit,
  blending: alpha,
  culling: none,
  parameters: [
    { type: vec4, name: tint, hint: source_color, default: [0.5, 0.8, 1.0, 1] },
    { type: float, name: density, hint: range(0, 1, 0.01), default: 0.55 },
    { type: float, name: brightness, default: 1.2 },
    { type: float, name: flash, hint: range(0, 1, 0.01), default: 0 },
    { type: float, name: dissolve, hint: range(0, 1, 0.01), default: 0 },
    // Seconds since the husk appeared. An unlit material is not given the
    // engine's clock, so the game passes its own.
    { type: float, name: time, default: 0 },
  ],
}

fragment {
  float Hash(vec3 p) {
    return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
  }

  float Noise(vec3 p) {
    vec3 cell = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);

    return mix(
        mix(mix(Hash(cell), Hash(cell + vec3(1, 0, 0)), f.x),
            mix(Hash(cell + vec3(0, 1, 0)), Hash(cell + vec3(1, 1, 0)), f.x),
            f.y),
        mix(mix(Hash(cell + vec3(0, 0, 1)), Hash(cell + vec3(1, 0, 1)), f.x),
            mix(Hash(cell + vec3(0, 1, 1)), Hash(cell + vec3(1, 1, 1)), f.x),
            f.y),
        f.z);
  }

  void Surface(inout MaterialInputs material) {
    vec3 world = GetWorldPosition();
    vec4 masks = GetVertexColor();
    float facing = abs(dot(GetWorldNormal(), GetViewDirection()));

    // Smoke that drifts upward through the cloth.
    float drift = Noise(vec3(world.x * 5.0, world.y * 5.0 - material_params.time * 0.5,
                             world.z * 5.0));
    float grain = Noise(world * 9.0) * 0.7 + Noise(world * 31.0) * 0.3;
    float front = material_params.dissolve * 1.2 - 0.1;
    if (grain < front) discard;

    float edge = pow(1.0 - facing, 1.6);
    float alpha = material_params.density * masks.a *
                  (0.35 + 0.65 * edge) * (0.6 + 0.4 * drift);
    vec3 color = material_params.tint.rgb * material_params.brightness *
                     (0.5 + edge + 0.4 * drift) +
                 vec3(material_params.flash * 0.5);

    material.base_color = vec4(color, clamp(alpha + material_params.flash * 0.3,
                                            0.0, 1.0));
    PrepareMaterial(material);
  }
}
